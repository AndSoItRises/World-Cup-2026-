# Python
venv/
__pycache__/
*.pyc
*.pyo
.env

# Data — raw CSVs can be large; ignore the whole dir by default...
data/raw/*
# ...but the cloud pipeline (.github/workflows/daily_update.yml) needs these small
# reference inputs present in a fresh CI checkout, so track them explicitly. The big
# odds dump (wc2026_match_odds.csv, ~1.3 MB) is NOT needed by the daily chain and
# stays ignored.
!data/raw/wc2026_fixtures.csv
!data/raw/current_fifa_rankings.csv
!data/raw/wc2026_live_results.csv

# Jupyter checkpoints
.ipynb_checkpoints/

# Claude Code session worktrees (refresh_all.ps1 does git add -A — never commit these)
.claude/

# OS
.DS_Store
Thumbs.db

# Logs
logs/

# Live update timestamped archives
data/processed/tournament_probs_live_*.csv
